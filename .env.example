# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Backend
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Set to true for local dev with zero AWS credentials (stubs auth, do not use in prod)
AUTH_DISABLED=false

# DynamoDB
DYNAMODB_TABLE_USAGE=ResourceUsage
DYNAMODB_TABLE_ALLOCATIONS=Allocations
DYNAMODB_TABLE_ALERTS=Alerts

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=ap-south-1

# SNS
SNS_TOPIC_ARN=

# Lambda
SCALING_LAMBDA_NAME=aura-scaling-handler
ALERT_LAMBDA_NAME=aura-alert-publisher

# ML Service
ML_SERVICE_URL=http://localhost:8000

# Carbon-aware scheduler (owned by the ML/scheduler track, PRD FR-SC-3/4).
# Called by src/aws/lambda/scaling-handler/. Unset = scaling proceeds
# immediately without a scheduling decision (pre-scheduler fallback).
SCHEDULER_SERVICE_URL=

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_REGION=ap-south-1
