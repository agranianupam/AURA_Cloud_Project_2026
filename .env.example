# AURA — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).

# ─────────────────────────────────────────
# AWS Credentials
# ─────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─────────────────────────────────────────
# Backend (Express.js — Prakul)
# ─────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────
# DynamoDB Tables
# ─────────────────────────────────────────
DYNAMODB_TABLE_USAGE=ResourceUsage
DYNAMODB_TABLE_ALLOCATIONS=Allocations
DYNAMODB_TABLE_ALERTS=Alerts

# ─────────────────────────────────────────
# Cognito
# ─────────────────────────────────────────
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_REGION=ap-south-1

# ─────────────────────────────────────────
# SNS
# ─────────────────────────────────────────
SNS_TOPIC_ARN=

# ─────────────────────────────────────────
# ML Service (FastAPI — Agrani)
# ─────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─────────────────────────────────────────
# Frontend (Vite — Pranav)
# ─────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=
VITE_COGNITO_REGION=ap-south-1
