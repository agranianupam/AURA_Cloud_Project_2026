{
  "name": "aura-backend",
  "version": "0.1.0",
  "description": "AURA backend API (file-store API in src/, AWS DynamoDB/Cognito API in server.js)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "start:aws": "node server.js",
    "seed": "node db/seed.js",
    "seed:dynamodb": "node scripts/seed-dynamodb.js",
    "test": "node --test \"test/*.test.js\" \"tests/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-sns": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "aws-jwt-verify": "^4.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
